# Local deployment only. Prefer `python3 scripts/configure.py` for random secrets.
POSTGRES_PASSWORD=replace-with-a-random-password
S3_ACCESS_KEY=filetrail-local
S3_SECRET_KEY=replace-with-a-long-random-secret
WEB_PORT=4173
# Set true only when serving the web application through HTTPS.
SECURE_COOKIE=false
